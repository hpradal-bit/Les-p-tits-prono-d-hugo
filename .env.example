# ---------------------------------------------------------------------------
# Supabase — https://supabase.com/dashboard → Project Settings → API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé de service : serveur uniquement. Ne JAMAIS la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Administrateurs : les adresses qui reçoivent les droits d'admin à
# l'inscription. Séparées par des virgules. Serveur uniquement.
# ---------------------------------------------------------------------------
ADMIN_EMAILS=hpradal@gmail.com

# ---------------------------------------------------------------------------
# Données sportives — chaîne de fournisseurs
# ---------------------------------------------------------------------------
# Ordre : TheSportsDB → Highlightly → ESPN → API-Sports
# Un fournisseur sans clé est simplement ignoré (ESPN n'en a pas besoin).

# TheSportsDB (principal) : 30 req/min, pas de quota journalier
# La clé 123 est la clé gratuite partagée. Patreon $3/mois pour une clé dédiée.
THESPORTSDB_KEY=123

# Highlightly (second) : 100 req/jour en gratuit via RapidAPI
# Créer un compte sur rapidapi.com, s'abonner à l'API Rugby Highlights
HIGHLIGHTLY_KEY=

# ESPN : aucune clé requise (API non documentée)
ESPN_RUGBY_LEAGUE_ID=270559

# API-Sports (dernier recours) : 100 req/jour gratuites, saisons 2022-2024 seulement
APISPORTS_KEY=

# ---------------------------------------------------------------------------
# Synchronisation planifiée (appelée par le Cloudflare Worker)
# ---------------------------------------------------------------------------
SYNC_SECRET=

# ---------------------------------------------------------------------------
# Notifications push (générer avec : npx web-push generate-vapid-keys)
#
# La clé PUBLIQUE ne se met pas ici : elle s'enregistre depuis l'espace admin
# (Administration → Notifications) et vit en base, pour éviter d'avoir à
# recompiler l'application à chaque changement.
# ---------------------------------------------------------------------------
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hpradal@gmail.com
